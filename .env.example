# TastePulse Environment Variables Example
# Copy this file to .env and provide your API keys

# Google Gemini API Key (Required for AI features: Win-Back Agent, Recipe Diagnostic, Chef Copilot, etc.)
# Get your free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional Backend API URL override (defaults to /api with Vite proxy)
# VITE_API_URL=http://localhost:5000/api
