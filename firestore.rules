rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.role == 'owner';
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Deterministic document ID + ownership guard:
      // Enforces at the database layer that reviewId MUST be '{restaurantId}_{authorUid}'.
      // Combined with 'allow update: if false', this guarantees duplicate review creation is impossible.
      allow create: if isAuthenticated() 
                    && request.resource.data.authorUid == request.auth.uid
                    && (
                        reviewId == request.resource.data.restaurantId + '_' + request.auth.uid ||
                        reviewId == request.resource.data.restaurantName + '_' + request.auth.uid
                    )
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;

      // Only the author or a verified restaurant owner can delete a review
      allow delete: if isAuthenticated() 
                    && (resource.data.authorUid == request.auth.uid 
                        || request.auth.token.role == 'owner');

      // Reviews are immutable once created (Phase 5)
      allow update: if false;

      // Optional edit history subcollection for audit trail
      match /edits/{editId} {
        allow read: if true;
        allow create: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Restaurants Collection
    match /restaurants/{restaurantId} {
      // Anyone can read restaurants
      allow read: if true;

      // Only verified owners can create a restaurant, and ownerUid must match auth.uid
      allow create: if isOwner() 
                    && request.resource.data.ownerUid == request.auth.uid;

      // Only the owning user can update or delete their restaurant
      allow update, delete: if isAuthenticated() 
                            && resource.data.ownerUid == request.auth.uid;
    }

    // Users Collection
    match /users/{uid} {
      // Authenticated users can read user profiles
      allow read: if isAuthenticated();

      // Users can only write their own profile document
      allow write: if isUser(uid);
    }
  }
}
